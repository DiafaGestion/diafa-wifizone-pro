{
  "name": "diafa-wifizone-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DIAFA WIFIZONE PRO — Gestion des ventes Mikhmon pour revendeurs Hotspot MikroTik",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.diafagroup.wifizonepro",
    "productName": "DIAFA WIFIZONE PRO",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" },
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DIAFA WIFIZONE PRO"
    }
  }
}
